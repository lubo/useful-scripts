#!/bin/bash
#
# Wrapper for commitpkg from Arch Linux devtools that works with AUR packages.

set -eo pipefail

archrelease() {
	exit
}

git() {
	case "$*" in
	"config --local devtools.variant")
		echo canonical
		;;
	"config --local devtools.version")
		echo "${GIT_REPO_SPEC_VERSION}"
		;;
	"symbolic-ref --short HEAD")
		echo main
		;;
	*)
		env git "$@"
		;;
	esac
}

gpg() {
	case "$1" in
	--detach-sign | --verify)
		;;
	*)
		env gpg "$@"
		;;
	esac
}

main() {
	export -f archrelease git gpg

	exec /usr/bin/commitpkg extra "$@"
}

main "$@"
