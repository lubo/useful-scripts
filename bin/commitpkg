#!/bin/bash
#
# Wrapper for commitpkg from Arch Linux devtools that works with AUR packages.

set -eo pipefail

archrelease() {
	exit
}

git() {
	case "$*" in
	"config --local devtools.variant")
		echo canonical
		;;
	"config --local devtools.version")
		(
			# shellcheck disable=SC1091
			source /usr/share/devtools/lib/common.sh
			echo "${GIT_REPO_SPEC_VERSION}"
		)
		;;
	"symbolic-ref --short HEAD")
		echo main
		;;
	*)
		env git "$@"
		;;
	esac
}

gpg() {
	case "$1" in
	--verify)
		;;
	*)
		env gpg "$@"
		;;
	esac
}

main() {
	(
		# shellcheck disable=SC1091
		source /usr/share/makepkg/util/config.sh
		source_makepkg_config

		local pkg_files=(*"${PKGEXT:?}")
		touch -- "${pkg_files[@]/%/.sig}"
	)

	export -f archrelease git gpg

	exec /usr/bin/commitpkg extra "$@"
}

main "$@"
